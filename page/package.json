{
  "name": "page",
  "version": "0.4.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "Roy Kid",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@molcrafts/molplot": "^0.1.3",
    "@molcrafts/molvis-core": "0.4.0",
    "@molcrafts/molvis-plugin": "0.4.0",
    "@molcrafts/molvis-sketch": "0.4.0",
    "@molcrafts/molvis-stage": "0.4.0",
    "@fluentui/react-icons": "2.0.344",
    "@molcrafts/ui": "0.1.0-alpha.1",
    "@molcrafts/ui-tokens": "0.1.0-alpha.1",
    "@radix-ui/react-slider": "^1.4.7",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "postcss": "^8.5.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.11.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/core": "^0.11.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@molcrafts/ui-tokens": "$@molcrafts/ui-tokens"
  },
  "scripts": {
    "dev": "wireit",
    "dev:python": "wireit",
    "build": "rsbuild build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "rstest run"
  },
  "wireit": {
    "dev": {
      "command": "rsbuild dev",
      "dependencies": [
        "../core:dev",
        "../stage:dev",
        "../sketch:dev",
        "../plugin:dev"
      ],
      "service": {
        "readyWhen": {
          "lineMatches": "Local:"
        }
      }
    },
    "dev:python": {
      "command": "MOLVIS_PYTHON_DEV=1 rsbuild build --watch",
      "dependencies": [
        "../core:dev",
        "../stage:dev",
        "../sketch:dev",
        "../plugin:dev"
      ],
      "service": true
    }
  }
}
