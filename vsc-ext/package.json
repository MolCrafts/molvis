{
  "name": "molvis",
  "displayName": "MolVis",
  "description": "A visual workspace where people and agents inspect molecular data together. 3D stage, 2D sketch, and the same MolVis surface as the web and Jupyter.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MolCrafts/molvis"
  },
  "homepage": "https://docs.molcrafts.org/molvis/interfaces/vscode/",
  "bugs": {
    "url": "https://github.com/molcrafts/molvis/issues"
  },
  "license": "BSD-3-Clause",
  "icon": "image/molvis-icon.png",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.120.0"
  },
  "publisher": "molcrafts",
  "activationEvents": [],
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "molecular",
    "visualization",
    "workspace",
    "stage",
    "sketch",
    "trajectory",
    "chemistry",
    "biology",
    "pdb",
    "lammps",
    "jupyter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "molvis",
          "title": "MolVis",
          "icon": "image/molvis-activitybar.svg"
        }
      ]
    },
    "views": {
      "molvis": [
        {
          "id": "molvis.files",
          "name": "Files",
          "visibility": "visible"
        },
        {
          "id": "molvis.stageOutline",
          "name": "Stage",
          "visibility": "visible",
          "when": "molvis.hasStageOutline"
        },
        {
          "id": "molvis.sketchOutline",
          "name": "Sketch",
          "visibility": "visible",
          "when": "molvis.hasSketchOutline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "molvis.files",
        "contents": "No molecular files in this workspace.\n[Open Structure…](command:molvis.openStructure)"
      }
    ],
    "commands": [
      {
        "command": "molvis.openStage",
        "title": "MolVis: Open Stage",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "molvis.openSketch",
        "title": "MolVis: Open Sketch",
        "icon": "$(edit)"
      },
      {
        "command": "molvis.openPage",
        "title": "MolVis: Open Page",
        "icon": "$(browser)"
      },
      {
        "command": "molvis.openInPage",
        "title": "Open in MolVis Page",
        "icon": "$(browser)"
      },
      {
        "command": "molvis.openStructure",
        "title": "MolVis: Open Structure…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "molvis.quickView",
        "title": "Quick look",
        "icon": "$(eye)"
      },
      {
        "command": "molvis.quickViewSketch",
        "title": "Quick look (Sketch)",
        "icon": "$(edit)"
      },
      {
        "command": "molvis.stageOutline.select",
        "title": "MolVis: Select Stage Outline Node"
      },
      {
        "command": "molvis.sketchOutline.select",
        "title": "MolVis: Select Sketch Outline Node"
      },
      {
        "command": "molvis.refreshFiles",
        "title": "MolVis: Refresh Files",
        "icon": "$(refresh)"
      },
      {
        "command": "molvis.removeRecent",
        "title": "MolVis: Remove from Recent",
        "icon": "$(close)"
      },
      {
        "command": "molvis.clearRecent",
        "title": "MolVis: Clear Recent Files",
        "icon": "$(clear-all)"
      },
      {
        "command": "molvis.openDocs",
        "title": "MolVis: Open Documentation",
        "icon": "$(book)"
      },
      {
        "command": "molvis.showOutput",
        "title": "MolVis: Show Output Channel",
        "icon": "$(output)"
      },
      {
        "command": "molvis.reload",
        "title": "MolVis: Reload View",
        "icon": "$(refresh)"
      },
      {
        "command": "molvis.save",
        "title": "MolVis: Save"
      },
      {
        "command": "molvis.showSource",
        "title": "Show Source",
        "icon": "$(go-to-file)"
      }
    ],
    "keybindings": [
      {
        "command": "molvis.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == molvis.editor || activeCustomEditorId == molvis.binaryEditor || activeWebviewPanelId == molvis.quickView || activeWebviewPanelId == molvis.stage || activeWebviewPanelId == molvis.sketch || activeWebviewPanelId == molvis.page"
      }
    ],
    "customEditors": [
      {
        "viewType": "molvis.editor",
        "displayName": "Quick look",
        "selector": [
          {
            "filenamePattern": "*.pdb"
          },
          {
            "filenamePattern": "*.ent"
          },
          {
            "filenamePattern": "*.brk"
          },
          {
            "filenamePattern": "*.xyz"
          },
          {
            "filenamePattern": "*.extxyz"
          },
          {
            "filenamePattern": "*.exyz"
          },
          {
            "filenamePattern": "*.cif"
          },
          {
            "filenamePattern": "*.mmcif"
          },
          {
            "filenamePattern": "*.data"
          },
          {
            "filenamePattern": "*.lmp"
          },
          {
            "filenamePattern": "*.lammps"
          },
          {
            "filenamePattern": "*.lammpsdata"
          },
          {
            "filenamePattern": "*.dump"
          },
          {
            "filenamePattern": "*.lammpstrj"
          },
          {
            "filenamePattern": "*.lmptrj"
          },
          {
            "filenamePattern": "*.lammpsdump"
          },
          {
            "filenamePattern": "*.sdf"
          },
          {
            "filenamePattern": "*.mol"
          },
          {
            "filenamePattern": "*.cube"
          },
          {
            "filenamePattern": "*.cub"
          },
          {
            "filenamePattern": "*.chgcar"
          },
          {
            "filenamePattern": "CHGCAR"
          },
          {
            "filenamePattern": "CHGCAR_*"
          },
          {
            "filenamePattern": "*.gro"
          },
          {
            "filenamePattern": "*.mol2"
          },
          {
            "filenamePattern": "*.poscar"
          },
          {
            "filenamePattern": "*.contcar"
          },
          {
            "filenamePattern": "*.vasp"
          },
          {
            "filenamePattern": "POSCAR"
          },
          {
            "filenamePattern": "POSCAR_*"
          },
          {
            "filenamePattern": "CONTCAR"
          },
          {
            "filenamePattern": "CONTCAR_*"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "molvis.binaryEditor",
        "displayName": "Quick look",
        "selector": [
          {
            "filenamePattern": "*.{dcd,trr,xtc,stl}"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.dcd": "molvis.binaryEditor",
        "*.trr": "molvis.binaryEditor",
        "*.xtc": "molvis.binaryEditor",
        "*.stl": "molvis.binaryEditor"
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "molvis.openStage"
        },
        {
          "command": "molvis.openSketch"
        },
        {
          "command": "molvis.openPage"
        },
        {
          "command": "molvis.openStructure"
        },
        {
          "command": "molvis.quickView"
        },
        {
          "command": "molvis.openInPage",
          "when": "(activeWebviewPanelId == molvis.quickView && molvis.activeSurfaceIsCanvas) || activeCustomEditorId == molvis.editor || activeCustomEditorId == molvis.binaryEditor"
        },
        {
          "command": "molvis.reload",
          "when": "activeCustomEditorId == molvis.editor || activeCustomEditorId == molvis.binaryEditor || activeWebviewPanelId == molvis.quickView || activeWebviewPanelId == molvis.stage || activeWebviewPanelId == molvis.sketch || activeWebviewPanelId == molvis.page"
        },
        {
          "command": "molvis.quickViewSketch",
          "when": "false"
        },
        {
          "command": "molvis.stageOutline.select",
          "when": "false"
        },
        {
          "command": "molvis.sketchOutline.select",
          "when": "false"
        },
        {
          "command": "molvis.refreshFiles",
          "when": "false"
        },
        {
          "command": "molvis.removeRecent",
          "when": "false"
        },
        {
          "command": "molvis.clearRecent",
          "when": "false"
        },
        {
          "command": "molvis.openDocs",
          "when": "false"
        },
        {
          "command": "molvis.showOutput",
          "when": "false"
        },
        {
          "command": "molvis.save",
          "when": "false"
        },
        {
          "command": "molvis.showSource",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "molvis.openStructure",
          "when": "view == molvis.files",
          "group": "navigation@1"
        },
        {
          "command": "molvis.refreshFiles",
          "when": "view == molvis.files",
          "group": "navigation@2"
        },
        {
          "command": "molvis.clearRecent",
          "when": "view == molvis.files",
          "group": "1_more"
        }
      ],
      "view/item/context": [
        {
          "command": "molvis.quickView",
          "when": "view == molvis.files && viewItem =~ /molvis\\.file/",
          "group": "1_open"
        },
        {
          "command": "molvis.openStage",
          "when": "view == molvis.files && viewItem =~ /sketch/",
          "group": "1_open"
        },
        {
          "command": "molvis.removeRecent",
          "when": "view == molvis.files && viewItem =~ /recent/",
          "group": "2_modify"
        }
      ],
      "editor/title": [
        {
          "command": "molvis.quickView",
          "when": "!activeCustomEditorId && activeWebviewPanelId != molvis.quickView && (resourceExtname == .pdb || resourceExtname == .ent || resourceExtname == .brk || resourceExtname == .xyz || resourceExtname == .extxyz || resourceExtname == .exyz || resourceExtname == .cif || resourceExtname == .mmcif || resourceExtname == .data || resourceExtname == .lmp || resourceExtname == .lammps || resourceExtname == .lammpsdata || resourceExtname == .dump || resourceExtname == .lammpstrj || resourceExtname == .lmptrj || resourceExtname == .lammpsdump || resourceExtname == .sdf || resourceExtname == .mol || resourceExtname == .cube || resourceExtname == .cub || resourceExtname == .chgcar || resourceExtname == .gro || resourceExtname == .mol2 || resourceExtname == .poscar || resourceExtname == .contcar || resourceExtname == .vasp || resourceExtname == .dcd || resourceExtname == .trr || resourceExtname == .xtc || resourceExtname == .stl || resourceExtname == .mrec || resourceFilename == CHGCAR || resourceFilename == POSCAR || resourceFilename == CONTCAR)",
          "group": "navigation"
        },
        {
          "command": "molvis.openInPage",
          "when": "(activeWebviewPanelId == molvis.quickView && molvis.activeSurfaceIsCanvas) || activeCustomEditorId == molvis.editor || activeCustomEditorId == molvis.binaryEditor",
          "group": "navigation"
        },
        {
          "command": "molvis.showSource",
          "when": "activeWebviewPanelId == molvis.quickView",
          "group": "navigation"
        },
        {
          "command": "molvis.reload",
          "when": "activeCustomEditorId == molvis.editor || activeCustomEditorId == molvis.binaryEditor || activeWebviewPanelId == molvis.quickView || activeWebviewPanelId == molvis.stage || activeWebviewPanelId == molvis.sketch || activeWebviewPanelId == molvis.page",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "molvis.openSketch",
          "when": "resourceExtname == .sdf || resourceExtname == .mol",
          "group": "navigation@1"
        },
        {
          "command": "molvis.openStage",
          "when": "resourceExtname == .pdb || resourceExtname == .ent || resourceExtname == .brk || resourceExtname == .xyz || resourceExtname == .extxyz || resourceExtname == .exyz || resourceExtname == .cif || resourceExtname == .mmcif || resourceExtname == .data || resourceExtname == .lmp || resourceExtname == .lammps || resourceExtname == .lammpsdata || resourceExtname == .dump || resourceExtname == .lammpstrj || resourceExtname == .lmptrj || resourceExtname == .lammpsdump || resourceExtname == .sdf || resourceExtname == .mol || resourceExtname == .cube || resourceExtname == .cub || resourceExtname == .chgcar || resourceExtname == .gro || resourceExtname == .mol2 || resourceExtname == .poscar || resourceExtname == .contcar || resourceExtname == .vasp || resourceExtname == .dcd || resourceExtname == .trr || resourceExtname == .xtc || resourceExtname == .stl || resourceExtname == .mrec || resourceFilename == CHGCAR || resourceFilename == POSCAR || resourceFilename == CONTCAR",
          "group": "navigation@2"
        },
        {
          "command": "molvis.quickView",
          "when": "resourceExtname == .pdb || resourceExtname == .ent || resourceExtname == .brk || resourceExtname == .xyz || resourceExtname == .extxyz || resourceExtname == .exyz || resourceExtname == .cif || resourceExtname == .mmcif || resourceExtname == .data || resourceExtname == .lmp || resourceExtname == .lammps || resourceExtname == .lammpsdata || resourceExtname == .dump || resourceExtname == .lammpstrj || resourceExtname == .lmptrj || resourceExtname == .lammpsdump || resourceExtname == .sdf || resourceExtname == .mol || resourceExtname == .cube || resourceExtname == .cub || resourceExtname == .chgcar || resourceExtname == .gro || resourceExtname == .mol2 || resourceExtname == .poscar || resourceExtname == .contcar || resourceExtname == .vasp || resourceExtname == .dcd || resourceExtname == .trr || resourceExtname == .xtc || resourceExtname == .stl || resourceExtname == .mrec || resourceFilename == CHGCAR || resourceFilename == POSCAR || resourceFilename == CONTCAR",
          "group": "navigation@3"
        },
        {
          "command": "molvis.quickViewSketch",
          "when": "resourceExtname == .sdf || resourceExtname == .mol",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "MolVis",
      "properties": {
        "molvis.defaultViewer": {
          "type": "string",
          "enum": [
            "quickLook",
            "page"
          ],
          "enumDescriptions": [
            "Open with just the canvas; reveal the full interface in place when you want it.",
            "Open with the full interface already showing (pipeline, compute, sidebars)."
          ],
          "default": "quickLook",
          "markdownDescription": "Whether a molecular file opens with the full interface or with just the canvas. Both are the same viewer: `quickLook` starts with the interface hidden and **Show controls** reveals it in place, so switching costs nothing and never re-reads the file."
        },
        "molvis.config": {
          "type": "object",
          "default": {},
          "markdownDescription": "Overrides passed to `@molcrafts/molvis-stage` config (`mountMolvis(container, config, settings)`).",
          "properties": {
            "showUI": {
              "type": "boolean",
              "description": "Show MolVis built-in overlay UI."
            },
            "useRightHandedSystem": {
              "type": "boolean",
              "description": "Use right-handed coordinate system."
            },
            "ui": {
              "type": "object",
              "description": "UI panel visibility flags.",
              "properties": {
                "showInfoPanel": {
                  "type": "boolean"
                },
                "showModePanel": {
                  "type": "boolean"
                },
                "showViewPanel": {
                  "type": "boolean"
                },
                "showPerfPanel": {
                  "type": "boolean"
                },
                "showTrajPanel": {
                  "type": "boolean"
                },
                "showContextMenu": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "canvas": {
              "type": "object",
              "description": "Canvas render context options.",
              "properties": {
                "antialias": {
                  "type": "boolean"
                },
                "alpha": {
                  "type": "boolean"
                },
                "preserveDrawingBuffer": {
                  "type": "boolean"
                },
                "stencil": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "molvis.settings": {
          "type": "object",
          "default": {},
          "markdownDescription": "Runtime overrides for `@molcrafts/molvis-stage` settings (`app.settings`).",
          "properties": {
            "showFps": {
              "type": "boolean",
              "default": true,
              "markdownDescription": "Show the FPS panel in the bottom-right corner of the viewport."
            },
            "cameraPanSpeed": {
              "type": "number"
            },
            "cameraRotateSpeed": {
              "type": "number"
            },
            "cameraZoomSpeed": {
              "type": "number"
            },
            "cameraInertia": {
              "type": "number"
            },
            "cameraPanInertia": {
              "type": "number"
            },
            "cameraMinRadius": {
              "type": "number"
            },
            "cameraMaxRadius": {
              "type": [
                "number",
                "null"
              ]
            },
            "grid": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "mainColor": {
                  "type": "string"
                },
                "lineColor": {
                  "type": "string"
                },
                "opacity": {
                  "type": "number"
                },
                "majorUnitFrequency": {
                  "type": "number"
                },
                "minorUnitVisibility": {
                  "type": "number"
                },
                "size": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            },
            "graphics": {
              "type": "object",
              "properties": {
                "shadows": {
                  "type": "boolean"
                },
                "postProcessing": {
                  "type": "boolean"
                },
                "ssao": {
                  "type": "boolean"
                },
                "bloom": {
                  "type": "boolean"
                },
                "ssr": {
                  "type": "boolean"
                },
                "dof": {
                  "type": "boolean"
                },
                "fxaa": {
                  "type": "boolean"
                },
                "hardwareScaling": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "molvis.plugins": {
          "type": "array",
          "default": [],
          "markdownDescription": "Reserved for a future Stage plugin capability. Not loaded by current Quick look / Stage / Sketch surfaces.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "scripts": {
    "clean:out": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "clean:out-test": "node -e \"require('node:fs').rmSync('out-test',{recursive:true,force:true})\"",
    "clean": "npm-run-all clean:out clean:out-test",
    "build:extension": "rslib build -c rslib.extension.config.mts",
    "build:webview:main": "rslib build -c rslib.webview.config.mts",
    "build:webview:worker": "rslib build -c rslib.webview.worker.config.mts",
    "build:webview": "npm run build:webview:main && npm run build:webview:worker && npm run build:webview:page",
    "build:webview:page": "rslib build -c rslib.webview.page.config.mts",
    "build:all": "npm-run-all clean:out build:extension build:webview",
    "build": "npm run build:all",
    "watch:extension": "rslib build --watch -c rslib.extension.config.mts",
    "watch:webview": "rslib build --watch -c rslib.webview.config.mts",
    "watch:typecheck": "tsc --noEmit --watch",
    "watch": "npm-run-all -p watch:extension watch:webview watch:typecheck",
    "dev": "npm run watch",
    "typecheck": "tsc --noEmit",
    "package:prepare": "NODE_ENV=production npm run build",
    "package": "npm run package:prepare",
    "vscode:prepublish": "npm run package",
    "test:compile": "tsc --project tsconfig.test.json",
    "test:unit:run": "mocha --ui tdd \"out-test/tests/**/*.test.js\"",
    "test:unit": "npm-run-all clean:out-test test:compile test:unit:run",
    "test": "npm run test:unit",
    "deploy:vsce": "vsce publish",
    "deploy": "npm run deploy:vsce",
    "deploy:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^0.23.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "autoprefixer": "^10.5.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.0.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@molcrafts/molvis-core": "0.4.0",
    "@molcrafts/molvis-sketch": "0.4.0",
    "@molcrafts/molvis-stage": "0.4.0"
  },
  "private": true
}
