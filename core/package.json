{
  "name": "@molcrafts/molvis-core",
  "version": "0.2.1",
  "type": "module",
  "description": "MolVis shared core: molrs gateway, element data, and framework-free shared controls (transitive dependency of stage/sketch; not a product install)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./molrs": {
      "types": "./dist/molrs.d.ts",
      "import": "./dist/molrs.js",
      "default": "./dist/molrs.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js",
      "default": "./dist/keys.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./element-picker": {
      "types": "./dist/element_picker.d.ts",
      "import": "./dist/element_picker.js",
      "default": "./dist/element_picker.js"
    },
    "./opfs": {
      "types": "./dist/opfs.d.ts",
      "import": "./dist/opfs.js",
      "default": "./dist/opfs.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    },
    "./save-file": {
      "types": "./dist/save_file.d.ts",
      "import": "./dist/save_file.js",
      "default": "./dist/save_file.js"
    },
    "./image-crop": {
      "types": "./dist/image_crop.d.ts",
      "import": "./dist/image_crop.js",
      "default": "./dist/image_crop.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.js",
      "default": "./dist/command.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./workload": {
      "types": "./dist/workload/index.d.ts",
      "import": "./dist/workload/index.js",
      "default": "./dist/workload/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/molrs.ts",
    "./dist/molrs.js"
  ],
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "rstest run"
  },
  "dependencies": {
    "@molcrafts/molrs": "^0.13.1"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rstest/browser": "^0.11.6",
    "@rstest/core": "^0.11.6",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2"
  },
  "author": "Roy Kid",
  "license": "BSD-3-Clause",
  "wireit": {
    "dev": {
      "command": "rslib build --watch",
      "service": {
        "readyWhen": {
          "lineMatches": "build completed, watching for changes"
        }
      }
    },
    "build": {
      "command": "rslib build"
    }
  }
}
