{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["node", "mocha", "vscode"],
    "paths": {
      "@/*": ["../page/src/*"],
      "@molcrafts/ui": ["../../molcrafts-ui/packages/ui/src/index.ts"],
      "@molcrafts/ui-tokens": [
        "../node_modules/@molcrafts/ui-tokens/dist/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "../page/src/**/*.d.ts"],
  "exclude": ["rslib.*.config.ts", "rslib.*.config.mts"]
}
