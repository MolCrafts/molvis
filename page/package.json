{
  "name": "page",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "Roy Kid",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@molcrafts/molplot": "^0.1.3",
    "@molcrafts/molvis-core": "0.2.0",
    "@molcrafts/molvis-plugin": "0.2.0",
    "@molcrafts/molvis-sketch": "0.2.0",
    "@molcrafts/molvis-stage": "0.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.11.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/browser": "^0.11.6",
    "@rstest/core": "^0.11.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "wireit",
    "dev:python": "wireit",
    "build": "rsbuild build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "rstest run --passWithNoTests"
  },
  "wireit": {
    "dev": {
      "command": "rsbuild dev",
      "dependencies": [
        "../core:dev",
        "../stage:dev",
        "../sketch:dev",
        "../plugin:dev"
      ],
      "service": {
        "readyWhen": {
          "lineMatches": "Local:"
        }
      }
    },
    "dev:python": {
      "command": "MOLVIS_PYTHON_DEV=1 rsbuild build --watch",
      "dependencies": [
        "../core:dev",
        "../stage:dev",
        "../sketch:dev",
        "../plugin:dev"
      ],
      "service": true
    }
  }
}
